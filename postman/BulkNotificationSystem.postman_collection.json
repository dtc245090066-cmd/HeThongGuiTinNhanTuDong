              "pm.test('Lay danh sach tra 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Danh sach co chien dich vua tao', function () {",
              "  const danhSach = pm.response.json();",
              "  pm.expect(danhSach).to.be.an('array');",
              "  pm.expect(danhSach.some(item => String(item.ma) === pm.collectionVariables.get('campaignId'))).to.eql(true);",
              "});"
