{
  "info": {
    "_postman_id": "d84bf211-2170-4b56-a785-e3bd59346e1f",
    "name": "BulkNotificationSystem",
    "description": "Postman tests for the Campaign API. Set baseUrl to the Notification.Api localhost URL before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5047",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "campaignId",
      "value": "",
      "type": "string"
    },
    {
      "key": "emptyCampaignId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runIdMoi = pm.environment.get('runId') || pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('runId', runIdMoi);",
          "}",
          "const runId = pm.collectionVariables.get('runId');",
          "pm.collectionVariables.set('tenChienDich', `Postman-${runId}`);",
          "pm.collectionVariables.set('emailNguoiNhan1', `nguoinhan1-${runId}@example.com`);",
          "pm.collectionVariables.set('emailNguoiNhan2', `nguoinhan2-${runId}@example.com`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Tao chien dich hop le",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenChienDich\": \"{{tenChienDich}}\",\n  \"tieuDe\": \"Thong bao lich bao tri\",\n  \"noiDung\": \"He thong se bao tri vao toi nay.\",\n  \"danhSachNguoiNhan\": [\n    { \"hoTen\": \"Nguyen Van A\", \"diaChiEmail\": \"{{emailNguoiNhan1}}\" },\n    { \"hoTen\": \"Tran Thi B\", \"diaChiEmail\": \"{{emailNguoiNhan2}}\" },\n    { \"hoTen\": \"Le Van C\", \"diaChiEmail\": \"nguoinhan3-{{runId}}@example.com\" },\n    { \"hoTen\": \"Pham Thi D\", \"diaChiEmail\": \"nguoinhan4-{{runId}}@example.com\" },\n    { \"hoTen\": \"Hoang Van E\", \"diaChiEmail\": \"nguoinhan5-{{runId}}@example.com\" }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/campaigns",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tra ve 201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Co ma chien dich va 5 nguoi nhan', function () {",
              "  pm.expect(body.ma).to.be.a('number');",
              "  pm.expect(body.soLuongNguoiNhan).to.eql(5);",
              "  pm.expect(body.nguoiNhans).to.have.lengthOf(5);",
              "});",
              "pm.test('Co header Location', function () { pm.response.to.have.header('Location'); });",
              "pm.collectionVariables.set('campaignId', String(body.ma));"
            ]
          }
        }
      ]
    },
    {
      "name": "1a. Bat dau chien dich",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/campaigns/{{campaignId}}/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns",
            "{{campaignId}}",
            "start"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bat dau chien dich tra 202 Accepted', function () { pm.response.to.have.status(202); });",
              "const body = pm.response.json();",
              "pm.test('Da tao Delivery va dua message vao queue', function () {",
              "  pm.expect(body.tongSoNguoiNhan).to.eql(5);",
              "  pm.expect(body.soDeliveryDuocTao).to.eql(5);",
              "  pm.expect(body.soMessageDaDuaVaoQueue).to.eql(5);",
              "  pm.expect(body.soMessageChuaDuaVaoQueue).to.eql(0);",
              "  pm.expect(body.trangThai).to.eql('Queued');",
              "  pm.expect(body.thongBao).to.include('Chua co email nao duoc gui');",
              "});"
            ]
          }
        }
      ]
    },
