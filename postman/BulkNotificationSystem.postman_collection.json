            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sau phuc hoi, publish tra 202', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('Khong tao lai Delivery, chien dich duoc xep hang doi', function () {",
                  "  pm.expect(body.trangThai).to.eql('Queued');",
                  "  pm.expect(body.soDeliveryDuocTao).to.eql(0);",
                  "  pm.expect(body.soMessageDaDuaVaoQueue).to.be.greaterThan(0);",
                  "  pm.expect(body.soMessageChuaDuaVaoQueue).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{rabbitDownCampaignId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
