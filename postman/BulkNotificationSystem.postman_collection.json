    {
      "name": "Kiem tra khi RabbitMQ mat ket noi",
      "item": [
        {
          "name": "Bat dau khi RabbitMQ dang tat",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('rabbitDownCampaignId')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RabbitMQ mat ket noi tra 503', function () { pm.response.to.have.status(503); });",
                  "const body = pm.response.json();",
                  "pm.test('Delivery chua publish duoc ghi nhan de thu lai', function () {",
                  "  pm.expect(body.trangThai).to.eql('Draft');",
                  "  pm.expect(body.soDeliveryDuocTao).to.be.greaterThan(0);",
                  "  pm.expect(body.soMessageChuaDuaVaoQueue).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/{{rabbitDownCampaignId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "campaigns",
                "{{rabbitDownCampaignId}}",
                "start"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Thu lai sau khi RabbitMQ hoat dong",
      "item": [
        {
          "name": "Thu lai Delivery chua publish",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('rabbitDownCampaignId')) { pm.execution.skipRequest(); }"
                ]
