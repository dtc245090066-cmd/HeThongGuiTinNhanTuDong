              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('emptyCampaignId')) {",
                  "  console.log('Bo qua: hay tao mot Campaign khong co Recipient trong SQL Server va dat emptyCampaignId.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
